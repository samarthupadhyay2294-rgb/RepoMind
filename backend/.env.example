# Copy to .env and fill in values. Never commit .env (see .gitignore).
# No real credentials belong in this file.

APP_NAME=RepoMind
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Explicit default chat provider: "ollama" (default, local-only) or "groq"
# (explicit opt-in; requires GROQ_API_KEY). A set GROQ_API_KEY alone never
# changes the default — credential presence is not provider selection.
LLM_PROVIDER=ollama
# Primary reasoning model (required): local Ollama only.
# 1. Start Ollama separately (RepoMind never runs ollama serve/pull/run).
# 2. Ensure gemma4:31b-cloud is available in your local Ollama.
# 3. Start RepoMind — it connects to http://localhost:11434.
# No API key is required; leave OLLAMA_API_KEY empty.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
# Optional supporting model (never an automatic fallback).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Embeddings (required for indexing/search; separate from chat LLMs above).
# 1. Copy this file to backend/.env and set MISTRAL_API_KEY there.
# 2. Restart the backend so it picks up the new value.
# EMBEDDING_DIMENSION must equal the model's output dimension (1024 for
# mistral-embed) — indexing rejects anything else before any write.
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024

# Hosted Qdrant (API key optional for local/unsecured servers).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=repomind
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_TOP_K=20

# Supabase PostgreSQL (direct or pooled connection string).
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Development owner until Supabase Auth lands.
DEV_OWNER_ID=local-dev-owner

REPOSITORY_STORAGE_PATH=./data/repositories

# Git acquisition bounds: bounded clone timeout; post-clone size cap
# (git cannot enforce transfer size — oversized workspaces are removed
# before ingestion).
REPOSITORY_CLONE_TIMEOUT_SECONDS=120
MAX_REPOSITORY_BYTES=524288000

# Agent bounds (enforced in code, not left to the model).
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=10

# run_validation allowlist (empty = disabled; opt in per deployment).
ENABLED_VALIDATIONS=

# Part 2 dependency graph (bounded, snapshot-scoped, evidence-backed).
# Local dev default: true. DEPENDENCY_GRAPH=false returns 403 GRAPH_DISABLED
# on graph routes only (chat unaffected). To disable in production, set
# DEPENDENCY_GRAPH=false explicitly in the deployment environment.
DEPENDENCY_GRAPH=true
GRAPH_MAX_DEPTH=3
GRAPH_MAX_NODES=100
GRAPH_MAX_EDGES=200
GRAPH_ENABLE_INFERRED_RELATIONSHIPS=false

# Part 3 repository overview (snapshot-scoped, evidence-grounded synthesis
# via local Ollama; ARCHITECTURE_OVERVIEW=false returns 403 on overview
# routes only). No Ollama API key is required. Local dev default: true;
# set false explicitly to disable in production.
ARCHITECTURE_OVERVIEW=true
OVERVIEW_MAX_EVIDENCE_ITEMS=24
OVERVIEW_MAX_EXCERPT_CHARS=1500
OVERVIEW_MAX_PROMPT_CHARS=24000
OVERVIEW_LLM_TIMEOUT_SECONDS=180

# Part 4 debug investigator (snapshot-scoped, bounded agent loop with
# evidence-mapped verdicts; DEBUG_INVESTIGATOR=false returns 403 on
# investigation routes only). No Ollama API key is required.
DEBUG_INVESTIGATOR=false

# Checkpoint backend ("postgres" when DATABASE_URL is reachable,
# otherwise in-memory with a logged warning).
LANGGRAPH_CHECKPOINT_BACKEND=postgres

# LangSmith tracing (opt-in).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
